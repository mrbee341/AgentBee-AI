# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Postgres connection string for the Supabase database (required)
DATABASE_URL=

# Port the HTTP server listens on (optional, default 3000)
PORT=3000

# Public HTTPS URL Telegram should send updates to, e.g. https://your-host.example.com/telegram/webhook (optional)
WEBHOOK_URL=

# Shared secret Telegram sends back with every update, checked by the server (optional, recommended)
WEBHOOK_SECRET=
